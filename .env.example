# Vorlage: nach .env kopieren und die Schlüssel eintragen. .env steht nicht im Repository.

# --- API-Football (Pflicht) ---
API_FOOTBALL_KEY=
ANALYZER_TIMEZONE=Europe/Berlin
API_TIMEOUT_MS=15000
API_REQUESTS_PER_MINUTE=300
API_REQUESTS_PER_SECOND=5
API_DAILY_RESERVE=100
STRENGTH_ON_DEMAND_REQUEST_BUDGET=300
LIVE_POLL_MS=15000
LIVE_DAILY_REQUEST_BUDGET=2000
LIVE_ALL_THRESHOLD=25

# Quoten-Anbieter bei API-Football: 32 = Betano, mit 32,8 kommt Bet365 als Ersatz dazu.
ODDS_BOOKMAKERS=32

# --- Angebotsliste deutscher Anbieter (src/oddspapi.ts) ---
# Welche Spiele analysiert werden. Ohne Schlüssel gilt die Näherung über die Tipico-Ligen.
# Kostenloses Konto bei oddspapi.io, 250 Aufrufe im Monat.
ODDSPAPI_KEY=
ODDSPAPI_BOOKMAKERS=betano.de,tipico
ODDSPAPI_RESERVE=10

# --- Sicherung der Datenbank nach jeder Analyse (src/backup.ts) ---
# Ohne Angabe data/backups/.
BACKUP_DIR=
BACKUP_KEEP=6
# Zusätzlich bei MEGA - ein eigenes Konto nur dafür, ohne Zwei-Faktor-Anmeldung.
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_FOLDER=api-football-analyzer
MEGA_KEEP=6

# --- Optional (Vorgaben im Code, nur bei Bedarf einkommentieren) ---
# SETTLE_REQUEST_BUDGET=200
# ELO_TOPUP_REQUEST_BUDGET=600
# ELO_AUTO_UPDATE=1
# BACKUP_AFTER_ANALYSIS=1
